# Screenwarden backend configuration.
#
# Copy to `.env` for local development and fill in real values there.
# `.env` is gitignored and must never be committed. This file lists
# variable names only - no values, no secrets.
#
# Every variable below also accepts a `_FILE` suffix (e.g.
# SCREENWARDEN_LOG_FILE) whose content is read as the value instead -
# for anything sensitive, point that at a mounted secret file rather
# than setting the plain variable. Setting both the plain and the
# `_FILE` form of the same variable is an error.

# Network address the backend binds to, e.g. 192.0.2.1:8080
SCREENWARDEN_BIND_ADDR=

# Directory for application data, including the SQLite database file.
SCREENWARDEN_DATA_DIR=

# Log verbosity: error, warn, info, debug, or trace.
SCREENWARDEN_LOG=

# Origin this instance is reached at, e.g. https://example.org or
# http://127.0.0.1:8080. Scheme and host only, no path. Incoming Origin
# headers on state-changing requests are checked against it. REQUIRED
# unless SCREENWARDEN_BIND_ADDR is a loopback address.
SCREENWARDEN_PUBLIC_URL=

# Comma-separated CIDRs whose peers may set X-Forwarded-For, e.g.
# 192.0.2.0/24. Empty means the header is ignored entirely, which is the
# right setting unless this server sits behind your own reverse proxy.
SCREENWARDEN_TRUSTED_PROXIES=

# Session lifetime, in seconds. Idle is measured from last use,
# absolute from login; a session must satisfy both. Defaults are 7 and
# 30 days. Idle must not exceed absolute.
SCREENWARDEN_SESSION_IDLE_SECS=
SCREENWARDEN_SESSION_ABSOLUTE_SECS=

# Argon2id cost. The server refuses to start below the OWASP minimum of
# m=19456 KiB, t=2, p=1, which is also the default. Raise m first if the
# machine has memory to spare.
SCREENWARDEN_ARGON2_M_COST_KIB=
SCREENWARDEN_ARGON2_T_COST=
SCREENWARDEN_ARGON2_P_COST=

# How many password hashes may run at once, and how long a request waits
# for a slot before it is shed with 503. Each concurrent hash costs
# about m_cost of memory, so this is the knob that bounds Argon2's RAM.
SCREENWARDEN_ARGON2_MAX_CONCURRENT=
SCREENWARDEN_ARGON2_WAIT_TIMEOUT_SECS=

# Rate limits, written as <max>/<window-seconds>. Login is limited per
# client address and, independently, per username so that a guessing
# attack spread across addresses still hits a wall. Windows always
# expire: there are no lockouts.
SCREENWARDEN_RATE_LIMIT_LOGIN_IP=
SCREENWARDEN_RATE_LIMIT_LOGIN_USERNAME=
SCREENWARDEN_RATE_LIMIT_SETUP_IP=

# Upper bound on rate-limit keys held in memory, so the limiter cannot
# be used to exhaust it.
SCREENWARDEN_RATE_LIMIT_MAX_ENTRIES=

# Devices, pairing and event ingest (M2).
SCREENWARDEN_MAX_DEVICES_PER_USER=
SCREENWARDEN_EVENT_MAX_AGE_SECS=
SCREENWARDEN_RATE_LIMIT_PAIR_IP=
SCREENWARDEN_RATE_LIMIT_PAIR_GLOBAL=
SCREENWARDEN_RATE_LIMIT_INGEST_DEVICE=
SCREENWARDEN_RATE_LIMIT_DEVICE_AUTH_FAIL=

# How long a freshly issued invite token remains redeemable. Default: 72 hours.
SCREENWARDEN_INVITE_TTL_SECS=

# Invite redemption attempts from one client address, per window. Default: 100/300. Behind a reverse proxy, SCREENWARDEN_TRUSTED_PROXIES must be set, or every client shares one address.
SCREENWARDEN_RATE_LIMIT_INVITE_IP=

# Invite redemption attempts across the whole instance, per window. Default: 600/60.
SCREENWARDEN_RATE_LIMIT_INVITE_GLOBAL=
