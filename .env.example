# Screenward backend configuration.
#
# Copy to `.env` for local development and fill in real values there.
# `.env` is gitignored and must never be committed. This file lists
# variable names only - no values, no secrets.
#
# Every variable below also accepts a `_FILE` suffix (e.g.
# SCREENWARD_LOG_FILE) whose content is read as the value instead -
# for anything sensitive, point that at a mounted secret file rather
# than setting the plain variable. Setting both the plain and the
# `_FILE` form of the same variable is an error.

# Network address the backend binds to, e.g. 192.0.2.1:8080
SCREENWARD_BIND_ADDR=

# Directory for application data, including the SQLite database file.
SCREENWARD_DATA_DIR=

# Log verbosity: error, warn, info, debug, or trace.
SCREENWARD_LOG=
