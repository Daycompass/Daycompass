# Copy to .env (`cp example.env .env`) and fill in. Placeholders only;
# never commit the real file.

# Your DuckDNS subdomain, without ".duckdns.org".
DUCKDNS_SUBDOMAIN=example

# The DuckDNS account token, shown at the top of the DuckDNS page when
# logged in. Treat it like a password: it can change every record on the
# account.
DUCKDNS_TOKEN=replace-with-your-duckdns-token

# The origin people open. Must be https://<DUCKDNS_SUBDOMAIN>.duckdns.org.
DAYCOMPASS_PUBLIC_URL=https://example.duckdns.org

# The compose network Caddy sits in, so the real client address is used
# for rate limits. Matches the subnet in docker-compose.yml.
DAYCOMPASS_TRUSTED_PROXIES=172.29.0.0/24

# DAYCOMPASS_INSECURE_COOKIES is deliberately not set: this deployment
# serves HTTPS, so the secure cookie works as designed.
