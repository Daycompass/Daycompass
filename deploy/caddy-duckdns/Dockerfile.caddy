# Caddy with the DuckDNS DNS-01 module compiled in. Both Caddy images are
# pinned by digest, the module by tag (v0.5.0 is commit
# 4ec390a9330122fa1ba10686ba221be0801df6ed; Go's checksum database
# verifies the module contents at build time). Bump all three together.
# The image digests are the multi-arch *index* digests, not a platform
# manifest's, so the build also works on ARM (a Raspberry Pi). When
# bumping, take the index digest: the `Docker-Content-Digest` header of
# the tag's manifest request, or `docker buildx imagetools inspect <tag>`.
# `podman image inspect` of a pulled image prints the platform digest.
FROM docker.io/library/caddy:2.11.7-builder@sha256:c2fc374fd352439d76e1777b28d97d9f6d9c1dd86116db9227460374d46097d5 AS build
RUN xcaddy build --with github.com/caddy-dns/duckdns@v0.5.0

FROM docker.io/library/caddy:2.11.7@sha256:504a44d7d74bd2bc28a66afc4774912fc21223ca8a67734af1c54ab2f999b489
COPY --from=build /usr/bin/caddy /usr/bin/caddy
